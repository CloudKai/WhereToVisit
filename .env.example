# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Required. Free key (no card) from https://www.geoapify.com/ -- place search and
# destination autocomplete. Free plan: ~3,000 requests/day.
GEOAPIFY_API_KEY=

# Optional. Used from step 2 (day plan routing). Free key from https://account.heigit.org/
ORS_API_KEY=

# Optional. If set, long recommendation notes are condensed to one line by an AI
# model that may only use the source text. The app works without it.
# NOTE: OpenAI keys are billed per use, unlike the free keys above.
OPENAI_API_KEY=
# Model id for condensing; change it if your account does not offer the default.
OPENAI_MODEL=gpt-5.4-mini
# Hard cap on model calls per day, per server process.
LLM_DAILY_CAP=150

# Optional. A contact email or URL included in the User-Agent sent to Wikimedia,
# as their API policy asks.
WIKIMEDIA_CONTACT=
