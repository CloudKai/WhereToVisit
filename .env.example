# Local NGINX browser origin; use 3000 only when running Next directly.
BETTER_AUTH_URL=http://127.0.0.1:8080
BETTER_AUTH_SECRET=REPLACE_WITH_A_HIGH_ENTROPY_LOCAL_SECRET
