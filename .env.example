# Local NGINX browser origin; use 3000 only when running Next directly.
BETTER_AUTH_URL=http://127.0.0.1:8080
BETTER_AUTH_SECRET=REPLACE_WITH_A_HIGH_ENTROPY_LOCAL_SECRET
DATABASE_PATH=./.data/wheretovisit.sqlite
# Development-only /development page. Has no effect in production or catalogue.
ENABLE_DEVELOPMENT_FIXTURES=0

# Explicit fictional map diagram; requires development AND a fixture publication.
# Ignored in production. Never enables live provider rendering.
ENABLE_DEVELOPMENT_MAP_FIXTURE=0

# Global importer switch. Live retrieval additionally needs a real public operator contact.
IMPORTS_ENABLED=0
WIKIMEDIA_OPERATOR_CONTACT=
# Authored import source fixtures: development AND explicit flag only. Ignored in production.
ENABLE_DEVELOPMENT_IMPORT_FIXTURE=0

# Fixture Trips require their own explicit development opt-in.
ENABLE_DEVELOPMENT_TRIP_FIXTURE=0
# Authored planning evidence: development fixture Trips only, never production.
ENABLE_DEVELOPMENT_DAY_PLAN_FIXTURE=0
DAY_PLAN_DEVELOPMENT_SOURCE=
