{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!.next",
      "!!node_modules",
      "!!drizzle/meta",
      "!!package-lock.json",
      "!!next-env.d.ts",
      "!!.nginx",
      "!!.scratch",
      "!!.data",
      "!!test-results",
      "!!playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
