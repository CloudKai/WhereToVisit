{
  "name": "wheretovisit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.8 <11"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "auth:schema": "auth generate --config ./src/server/auth-schema-config.ts --adapter drizzle --dialect sqlite --output ./src/server/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "node --import tsx ./src/server/db/migrate.ts",
    "nginx:check": "node scripts/nginx.mjs check",
    "nginx:serve": "node scripts/nginx.mjs serve",
    "nginx:stop": "node scripts/nginx.mjs stop",
    "config:local": "node scripts/init-local.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "@next/env": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "better-auth": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0"
  }
}
