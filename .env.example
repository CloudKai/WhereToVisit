# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# Required. Free key (no card) from https://www.geoapify.com/ -- place search and
# destination autocomplete. Free plan: ~3,000 requests/day.
GEOAPIFY_API_KEY=

# Optional. Road-based travel times and the "Shortest route" button on the day
# plan. Free key from https://account.heigit.org/ -- without it the plan still
# works using straight-line estimates, clearly labelled as such.
ORS_API_KEY=
# api.openrouteservice.org is deprecated; the current public host is below.
ORS_BASE_URL=https://api.heigit.org/openrouteservice
# Hard cap on routing requests per day, per server process (free plan ~2,000).
ORS_DAILY_CAP=1200

# Optional. If set, long recommendation notes are condensed to one line by an AI
# model that may only use the source text. The app works without it.
# NOTE: OpenAI keys are billed per use, unlike the free keys above.
OPENAI_API_KEY=
# Model id for condensing; change it if your account does not offer the default.
OPENAI_MODEL=gpt-5.4-mini
# Model that turns the sound of an uploaded recording into text.
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Hard cap on model calls per day, per server process.
LLM_DAILY_CAP=150

# Optional. A contact email or URL included in the User-Agent sent to Wikimedia,
# as their API policy asks.
WIKIMEDIA_CONTACT=

# Optional. Needed for "Vote on it with friends" when deployed (votes must be
# stored somewhere shared). Free Upstash Redis works on Vercel AND AWS:
#  - Vercel: Storage / Marketplace -> Upstash Redis. It adds KV_REST_API_URL and
#    KV_REST_API_TOKEN for you (also accepted here).
#  - Anywhere else: create a free database at https://upstash.com and copy the
#    REST URL and REST token below.
# Locally (npm run dev) votes are kept in memory without these -- fine for
# testing, lost on restart. In production without them, voting is switched off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Visitors can share TikTok / Instagram / Xiaohongshu post links for a place
# ("Seen on TikTok"). Needs the Redis settings above in production. Set to 0 to
# switch the feature off, for example if links are being abused.
COMMUNITY_POSTS=1

# "From links" page: when on, the caption of a pasted TikTok link is read through
# TikTok's public embed endpoint to find place names. OFF by default -- read
# TikTok's terms for that endpoint before enabling. Without it, people paste the
# caption or type place names themselves (always the case for Instagram and
# Xiaohongshu, which do not allow other apps to read posts).
TIKTOK_OEMBED=0
